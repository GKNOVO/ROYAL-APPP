# Token do bot (obrigatório)
DISCORD_TOKEN=COLE_SEU_TOKEN_AQUI

# Quem o bot chama no botão "Chamar host" (opcional aqui; pode usar /sethost no Discord)
# Preencha só um dos dois:
HOST_ROLE_ID=
HOST_USUARIO_ID=

# Onde os dados ficam salvos (não precisa mexer)
DATA_FILE=data/dados.json

# Tempo mínimo entre duas chamadas de host, em milissegundos
COOLDOWN_HOST_MS=60000
